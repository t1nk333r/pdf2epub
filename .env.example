# Docker host port only; the web settings panel cannot change the active listener.
# PDF2EPUB_PORT=8000
# Durable job root. Contains uploaded books, OCR text, images, and checkpoints.
# PDF2EPUB_DATA_DIR=/var/lib/pdf2epub

# Ollama local defaults
PDF2EPUB_OLLAMA_BASE_URL=http://127.0.0.1:11434
PDF2EPUB_OLLAMA_MODEL=qwen3-vl:32b-instruct-gpu
PDF2EPUB_OLLAMA_NUM_CTX=8192
# PDF2EPUB_OLLAMA_API_KEY=

# Hosted OpenAI-compatible vision provider
# PDF2EPUB_VISION_BASE_URL=https://provider.example/v1
# PDF2EPUB_VISION_MODEL=arabic-vision-model
# PDF2EPUB_VISION_API_KEY=replace-me

# Mistral's dedicated Document AI OCR endpoint
# PDF2EPUB_MISTRAL_BASE_URL=https://api.mistral.ai/v1
# PDF2EPUB_MISTRAL_MODEL=mistral-ocr-latest
# PDF2EPUB_MISTRAL_API_KEY=replace-me

PDF2EPUB_OCR_TIMEOUT=300
